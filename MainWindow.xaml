<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="700" Width="900"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen"
        MinHeight="550" MinWidth="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontFamily="Courier New" FontSize="11" Foreground="#00FFFF"
                   HorizontalAlignment="Center" Margin="0,10,0,5"
                   Text=" ██████╗██╗ ██╗██████╗ ███████╗██████╗&#10; ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗&#10; ██║ ╚████╔╝ ██████╔╝█████╗ ██████╔╝&#10; ██║ ╚██╔╝ ██╔══██╗██╔══╝ ██╔══██╗&#10; ╚██████╗ ██║ ██████╔╝███████╗██║ ██║&#10; ╚═════╝ ╚═╝ ╚═════╝ ╚══════╝╚═╝ ╚═╝"/>

        <StackPanel Grid.Row="1" Margin="0,5,0,5">
            <Separator Background="#00CED1"/>
            <TextBlock Text=" Cybersecurity Awareness Bot - South Africa"
                       Foreground="#00FF88" FontFamily="Courier New" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,4,0,4"/>
            <Separator Background="#00CED1"/>
        </StackPanel>

        <TabControl Grid.Row="2" Background="#0D1117" BorderBrush="#00CED1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#161B22"/>
                    <Setter Property="Foreground" Value="#00CED1"/>
                    <Setter Property="FontFamily" Value="Courier New"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="{TemplateBinding Background}"
                                        BorderBrush="#00CED1" BorderThickness="1,1,1,0"
                                        Padding="{TemplateBinding Padding}" Margin="2,2,2,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#00CED1"/>
                                        <Setter Property="Foreground" Value="#0D1117"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: CHAT -->
            <TabItem Header="💬 Chat">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" x:Name="ChatScroller"
                                  VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" Background="#0D1117">
                        <RichTextBox x:Name="ChatBox" IsReadOnly="True"
                                     Background="#0D1117" BorderThickness="1" BorderBrush="#00CED1"
                                     FontFamily="Courier New" FontSize="13" Padding="10"
                                     VerticalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UserInput" Grid.Column="0"
                                 Background="#161B22" Foreground="#FFFFFF" CaretBrush="White"
                                 BorderBrush="#00CED1" BorderThickness="1"
                                 FontFamily="Courier New" FontSize="13" Padding="8,6"
                                 VerticalContentAlignment="Center" KeyDown="UserInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Send" Width="80" Margin="8,0,0,0"
                                Background="#00CED1" Foreground="#0D1117" FontWeight="Bold"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="SendButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: TASKS -->
            <TabItem Header="📋 Tasks">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Add a Cybersecurity Task"
                               Foreground="#00CED1" FontFamily="Courier New"
                               FontSize="14" FontWeight="Bold" Margin="0,5,0,10"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TaskTitleInput" Grid.Column="0"
                                 Background="#161B22" Foreground="White" CaretBrush="White"
                                 BorderBrush="#00CED1" BorderThickness="1"
                                 FontFamily="Courier New" FontSize="12" Padding="6,4" Margin="0,0,5,0"/>
                        <TextBox x:Name="TaskReminderInput" Grid.Column="1"
                                 Background="#161B22" Foreground="White" CaretBrush="White"
                                 BorderBrush="#00CED1" BorderThickness="1"
                                 FontFamily="Courier New" FontSize="12" Padding="6,4" Margin="0,0,5,0"/>
                        <Button Grid.Column="2" Content="Add Task" Width="90" Padding="0,4"
                                Background="#00FF88" Foreground="#0D1117" FontWeight="Bold"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="AddTaskButton_Click"/>
                    </Grid>
                    <ListView x:Name="TaskListView" Grid.Row="2"
                              Background="#161B22" Foreground="White"
                              BorderBrush="#00CED1" BorderThickness="1"
                              FontFamily="Courier New" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="35" DisplayMemberBinding="{Binding Id}"/>
                                <GridViewColumn Header="Title" Width="180" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Description" Width="250" DisplayMemberBinding="{Binding Description}"/>
                                <GridViewColumn Header="Reminder" Width="120" DisplayMemberBinding="{Binding Reminder}"/>
                                <GridViewColumn Header="Done" Width="55" DisplayMemberBinding="{Binding IsCompleted}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="✓ Complete Selected" Margin="0,0,8,0" Padding="10,5"
                                Background="#00CED1" Foreground="#0D1117" FontWeight="Bold"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="CompleteTaskButton_Click"/>
                        <Button Content="🗑 Delete Selected" Margin="0,0,8,0" Padding="10,5"
                                Background="#FF4444" Foreground="White" FontWeight="Bold"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="DeleteTaskButton_Click"/>
                        <Button Content="↻ Refresh" Padding="10,5"
                                Background="#444" Foreground="White"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="RefreshTasksButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: QUIZ -->
            <TabItem Header="🎮 Quiz">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Cybersecurity Mini-Game"
                               Foreground="#00CED1" FontFamily="Courier New"
                               FontSize="14" FontWeight="Bold" Margin="0,5,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <RichTextBox x:Name="QuizBox" IsReadOnly="True"
                                     Background="#161B22" Foreground="White"
                                     BorderBrush="#00CED1" BorderThickness="1"
                                     FontFamily="Courier New" FontSize="13" Padding="10"
                                     VerticalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuizAnswerInput" Grid.Column="0"
                                 Background="#161B22" Foreground="White" CaretBrush="White"
                                 BorderBrush="#00CED1" BorderThickness="1"
                                 FontFamily="Courier New" FontSize="13" Padding="8,6"
                                 VerticalContentAlignment="Center" KeyDown="QuizAnswerInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Answer" Width="90" Margin="8,0,0,0"
                                Background="#00CED1" Foreground="#0D1117" FontWeight="Bold"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="QuizAnswerButton_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="▶ Start Quiz" Margin="0,0,8,0" Padding="12,5"
                                Background="#00FF88" Foreground="#0D1117" FontWeight="Bold"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="StartQuizButton_Click"/>
                        <Button Content="■ Stop Quiz" Padding="12,5"
                                Background="#FF4444" Foreground="White" FontWeight="Bold"
                                FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                                Click="StopQuizButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 4: LOG -->
            <TabItem Header="📜 Log">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Activity Log"
                               Foreground="#00CED1" FontFamily="Courier New"
                               FontSize="14" FontWeight="Bold" Margin="0,5,0,10"/>
                    <ListBox x:Name="LogListBox" Grid.Row="1"
                             Background="#161B22" Foreground="#00FF88"
                             BorderBrush="#00CED1" BorderThickness="1"
                             FontFamily="Courier New" FontSize="12" Padding="5"/>
                    <Button Grid.Row="2" Content="↻ Refresh Log"
                            Margin="0,8,0,0" Padding="12,5" HorizontalAlignment="Left"
                            Background="#00CED1" Foreground="#0D1117" FontWeight="Bold"
                            FontFamily="Courier New" BorderThickness="0" Cursor="Hand"
                            Click="RefreshLogButton_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>